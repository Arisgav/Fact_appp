<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ni.edu.uam.fact_appp.controller.CategoriaController"
            prefHeight="400.0" prefWidth="600.0">

    <children>
        <BorderPane AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">

            <center>
                <GridPane hgap="10.0" vgap="10.0" BorderPane.alignment="CENTER">
                    <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                    </padding>

                    <columnConstraints>
                        <ColumnConstraints hgrow="NEVER" minWidth="80.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
                    </columnConstraints>

                    <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                    </rowConstraints>

                    <Label text="Nombre:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                    <TextField fx:id="txtNombreCategoria" GridPane.rowIndex="0" GridPane.columnIndex="1" />

                    <CheckBox fx:id="chkActivaCategoria" text="Activa"
                              GridPane.rowIndex="1" GridPane.columnIndex="0" GridPane.columnSpan="2" />
                </GridPane>
            </center>

            <bottom>
                <VBox spacing="10.0">
                    <children>
                        <TableView fx:id="tblCategorias" prefHeight="200.0">
                            <columns>
                                <TableColumn fx:id="colNombreCategoria" text="Nombre" />
                                <TableColumn fx:id="colActivaCategoria" text="Activa" />
                            </columns>
                        </TableView>

                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                            <padding>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="0.0" />
                            </padding>
                            <children>
                                <Button fx:id="btnGuardarCategoria" text="Guardar" onAction="#guardarCategoria" />
                                <Button fx:id="btnQuitarCategoria" text="Quitar" onAction="#quitarCategoria" />
                                <Button fx:id="btnCerrarCategoria" text="Cerrar" onAction="#cerrarCategoria" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </bottom>

        </BorderPane>
    </children>

</AnchorPane>
