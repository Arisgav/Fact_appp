<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="CONTROLLER_NAME"
            prefHeight="600.0" prefWidth="800.0">

    <children>
        <BorderPane AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">

            <center>
                <GridPane hgap="10.0" vgap="10.0" BorderPane.alignment="CENTER">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>

                    <columnConstraints>
                        <ColumnConstraints hgrow="NEVER" minWidth="100.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
                        <ColumnConstraints hgrow="NEVER" minWidth="150.0" />
                    </columnConstraints>

                    <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints vgrow="ALWAYS" />
                    </rowConstraints>

                    <!-- Código -->
                    <Label text="Código:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                    <TextField fx:id="txtCodigo" GridPane.rowIndex="0" GridPane.columnIndex="1" />

                    <!-- Nombre -->
                    <Label text="Nombre:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                    <TextField fx:id="txtNombre" GridPane.rowIndex="1" GridPane.columnIndex="1" />

                    <!-- Categoría -->
                    <Label text="Categoría:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                    <ComboBox fx:id="cmbCategoria" maxWidth="1.7976931348623157E308"
                              GridPane.rowIndex="2" GridPane.columnIndex="1" />

                    <!-- Precio -->
                    <Label text="Precio:" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                    <TextField fx:id="txtPrecio" GridPane.rowIndex="3" GridPane.columnIndex="1" />

                    <!-- Existencia -->
                    <Label text="Existencia:" GridPane.rowIndex="4" GridPane.columnIndex="0" />
                    <TextField fx:id="txtExistencia" GridPane.rowIndex="4" GridPane.columnIndex="1" />

                    <!-- Activo -->
                    <CheckBox fx:id="chkActivo" text="Activo" GridPane.rowIndex="5" GridPane.columnIndex="0" GridPane.columnSpan="2" />

                    <!-- Vista previa de imagen -->
                    <VBox alignment="TOP_CENTER" spacing="10.0"
                          GridPane.rowIndex="0" GridPane.columnIndex="2" GridPane.rowSpan="6">
                        <children>
                            <Label text="Vista previa" />
                            <ImageView fx:id="imgProducto" fitHeight="150.0" fitWidth="150.0" preserveRatio="true" />
                            <Button fx:id="btnImagen" text="Seleccionar imagen" onAction="#seleccionarImagen" maxWidth="1.7976931348623157E308" />
                        </children>
                    </VBox>

                </GridPane>
            </center>

            <bottom>
                <VBox spacing="10.0">
                    <children>
                        <TableView fx:id="tblProductos" prefHeight="200.0">
                            <columns>
                                <TableColumn text="Código" />
                                <TableColumn text="Nombre" />
                                <TableColumn text="Categoría" />
                                <TableColumn text="Precio" />
                                <TableColumn text="Existencia" />
                                <TableColumn text="Activo" />
                            </columns>
                        </TableView>

                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                            <padding>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="0.0" />
                            </padding>
                            <children>
                                <Button fx:id="btnGuardar" text="Guardar" onAction="#guardar" />
                                <Button fx:id="btnCerrar" text="Cerrar" onAction="#cerrar" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </bottom>

        </BorderPane>
    </children>

</AnchorPane>
