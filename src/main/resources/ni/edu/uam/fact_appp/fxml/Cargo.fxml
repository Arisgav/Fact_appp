<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="450.0" prefWidth="650.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.fact_appp.controller.CargoController">
    <children>
        <VBox spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <Label text="Gestión de Cargos" style="-fx-font-size: 20px; -fx-font-weight: bold;" />

                <!-- Formulario -->
                <GridPane hgap="10.0" vgap="10.0">
                    <columnConstraints>
                        <ColumnConstraints minWidth="80.0" />
                        <ColumnConstraints minWidth="250.0" />
                    </columnConstraints>
                    <children>
                        <Label text="ID:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                        <TextField fx:id="txtIdCargo" editable="false" promptText="Autogenerado" GridPane.rowIndex="0" GridPane.columnIndex="1" />

                        <Label text="Nombre:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                        <TextField fx:id="txtNombreCargo" promptText="Nombre del cargo" GridPane.rowIndex="1" GridPane.columnIndex="1" />

                        <Label text="Descripción:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                        <TextField fx:id="txtDescripcionCargo" promptText="Descripción del cargo" GridPane.rowIndex="2" GridPane.columnIndex="1" />
                    </children>
                </GridPane>

                <!-- Botones -->
                <HBox spacing="10.0">
                    <children>
                        <Button fx:id="btnGuardar" text="Guardar" onAction="#guardarCargo" />
                        <Button fx:id="btnModificar" text="Modificar" onAction="#modificarCargo" />
                        <Button fx:id="btnEliminar" text="Eliminar" onAction="#eliminarCargo" />
                        <Button fx:id="btnLimpiar" text="Limpiar" onAction="#limpiarCampos" />
                    </children>
                </HBox>

                <!-- Tabla de listado -->
                <Label text="Lista de Cargos" style="-fx-font-weight: bold;" />
                <TableView fx:id="tablaCargos" prefHeight="200.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="60.0" />
                        <TableColumn fx:id="colNombre" text="Nombre" prefWidth="200.0" />
                        <TableColumn fx:id="colDescripcion" text="Descripción" prefWidth="280.0" />
                    </columns>
                </TableView>
            </children>
        </VBox>
    </children>
</AnchorPane>
